<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Regla para permitir solo a asociados modificar stock manual -->
    <record id="rule_product_template_manual_stock" model="ir.rule">
        <field name="name">Product Template: Manual Stock Only for Asociados</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('is_manual_stock_modified', '=', False),
            '&amp;',
            ('is_manual_stock_modified', '=', True),
            '|',
            ('create_uid.is_asociado', '=', True),
            ('create_uid.has_group', '=', 'base.group_system')
        ]</field>
    </record>

    <!-- Regla similar para variantes -->
    <record id="rule_product_product_manual_stock" model="ir.rule">
        <field name="name">Product Product: Manual Stock Only for Asociados</field>
        <field name="model_id" ref="model_product_product"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('is_manual_stock_modified', '=', False),
            '&amp;',
            ('is_manual_stock_modified', '=', True),
            '|',
            ('create_uid.is_asociado', '=', True),
            ('create_uid.has_group', '=', 'base.group_system')
        ]</field>
    </record>
</odoo>