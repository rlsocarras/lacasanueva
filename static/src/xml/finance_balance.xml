<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lacasanueva.FinanceBalanceDashboard">
        <div class="o_action lacasanueva_finance_balance d-flex flex-column">

            <!-- Panel de control (estilo tableros Odoo 18) -->
            <div class="o_control_panel d-flex flex-column flex-lg-row flex-wrap gap-2 gap-lg-3 px-3 pt-2 pb-3 justify-content-between align-items-lg-start">

                <div class="o_control_panel_breadcrumbs d-flex align-items-center gap-1 order-0 h-lg-100">
                    <button class="btn btn-light btn-sm" t-on-click="toggleSearchPanel"
                            t-att-title="state.searchPanelCollapsed ? 'Mostrar panel de reportes' : 'Ocultar panel de reportes'">
                        <i t-att-class="state.searchPanelCollapsed ? 'fa fa-fw fa-angle-double-right' : 'fa fa-fw fa-angle-double-left'"/>
                    </button>
                    <div class="o_breadcrumb d-flex gap-1 text-truncate">
                        <div class="o_last_breadcrumb_item active d-flex fs-4 min-w-0 align-items-center">
                            <span class="min-w-0 text-truncate">Balance de Compras y Ventas</span>
                        </div>
                    </div>
                </div>

                <div class="o_control_panel_main d-flex flex-wrap flex-lg-nowrap gap-2 gap-lg-3 align-items-center order-2 order-lg-1 flex-grow-1">

                    <div class="o-filter-value d-flex align-items-center">
                        <select t-on-change="onFilterChange"
                                t-model="state.filterType"
                                class="form-select o_input"
                                style="width: 200px;">
                            <option value="year">Año</option>
                            <option value="month">Mes</option>
                            <option value="quarter">Trimestre</option>
                            <option value="range">Rango de fechas</option>
                            <option value="specific">Fecha específica</option>
                        </select>
                    </div>

                    <t t-if="state.filterType === 'year' or state.filterType === 'month' or state.filterType === 'quarter'">
                        <div class="o-filter-value d-flex align-items-center">
                            <input type="number"
                                   t-model="state.year"
                                   class="form-control o_input"
                                   style="width: 120px;"
                                   placeholder="Año"
                                   min="2000" max="2100"/>
                        </div>
                    </t>

                    <t t-if="state.filterType === 'month'">
                        <div class="o-filter-value d-flex align-items-center">
                            <select t-model="state.month" class="form-select o_input" style="width: 150px;">
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                        </div>
                    </t>

                    <t t-if="state.filterType === 'quarter'">
                        <div class="o-filter-value d-flex align-items-center">
                            <select t-model="state.quarter" class="form-select o_input" style="width: 150px;">
                                <option value="1">1° Trimestre</option>
                                <option value="2">2° Trimestre</option>
                                <option value="3">3° Trimestre</option>
                                <option value="4">4° Trimestre</option>
                            </select>
                        </div>
                    </t>

                    <t t-if="state.filterType === 'range'">
                        <div class="o-filter-value d-flex align-items-center">
                            <input type="date" t-model="state.dateFrom" class="form-control o_input" style="width: 180px;"/>
                        </div>
                        <span class="align-self-center">hasta</span>
                        <div class="o-filter-value d-flex align-items-center">
                            <input type="date" t-model="state.dateTo" class="form-control o_input" style="width: 180px;"/>
                        </div>
                    </t>

                    <t t-if="state.filterType === 'specific'">
                        <div class="o-filter-value d-flex align-items-center">
                            <input type="date" t-model="state.specificDate" class="form-control o_input" style="width: 180px;"/>
                        </div>
                    </t>

                    <button class="btn btn-primary" t-on-click="onApplyFilter">
                        <i class="fa fa-search me-1"/> Consultar
                    </button>
                </div>

                <div class="o_control_panel_actions d-flex align-items-center order-1 order-lg-2">
                    <button class="btn btn-light o-dropdown dropdown-toggle" t-on-click="shareDashboard">
                        <i class="fa fa-share-alt"/> Compartir
                    </button>
                </div>
            </div>

            <div class="o_content d-flex flex-grow-1">

                <!-- Panel lateral de reportes (estilo Odoo 18) -->
                <div t-att-class="state.searchPanelCollapsed ? 'd-none' : 'o_spreadsheet_dashboard_search_panel o_search_panel flex-grow-0 border-end flex-shrink-0 pe-2 pb-5 ps-4 overflow-auto position-relative bg-view'">
                    <div class="mt-2"/>
                    <section class="o_search_panel_section o_search_panel_category">
                        <header class="o_search_panel_section_header pt-4 pb-2 text-uppercase o_cursor_default user-select-none">
                            <b>Reportes</b>
                        </header>
                        <ul class="list-group d-block o_search_panel_field">
                            <li t-foreach="[['balance', 'Balance de Compras y Ventas']]"
                                t-as="item"
                                t-key="item[0]"
                                t-attf-class="o_search_panel_category_value list-group-item cursor-pointer border-0 d-flex justify-content-between align-items-center {{ state.activeReport === item[0] ? 'active' : '' }}"
                                t-on-click="() => setActiveReport(item[0])">
                                <div class="o_dashboard_name">
                                    <t t-esc="item[1]"/>
                                </div>
                            </li>
                        </ul>
                    </section>
                </div>

                <!-- Área de contenido -->
                <div class="o_renderer flex-grow-1 overflow-auto p-3">

                    <t t-if="state.error">
                        <div class="alert alert-danger">
                            <i class="fa fa-exclamation-triangle me-2"/>
                            <t t-esc="state.error"/>
                        </div>
                    </t>

                    <t t-elif="state.loading">
                        <div class="text-center py-4">
                            <i class="fa fa-spinner fa-spin fa-2x"/>
                            <p class="mt-2">Cargando datos...</p>
                        </div>
                    </t>

                    <t t-else="">
                        <div class="card mb-4 mx-auto" style="max-width: 1097px;">
                            <div class="card-body">
                                <canvas t-ref="chart" style="max-height: 450px;"/>
                            </div>
                        </div>

                        <div class="card mb-4 mx-auto" style="max-width: 1097px;">
                            <div class="card-body">
                                <canvas t-ref="chartLine" style="max-height: 450px;"/>
                            </div>
                        </div>

                        <div class="row mt-4 mx-auto" style="max-width: 1097px;">
                            <div class="col-md-4">
                                <div class="card text-white" style="background-color: #7ba7cc;">
                                    <div class="card-body text-center">
                                        <h6 class="card-title">Ventas</h6>
                                        <h3>
                                            <t t-esc="formatCurrency(state.chartData.sales)"/> $
                                        </h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-white" style="background-color: #d18bb0;">
                                    <div class="card-body text-center">
                                        <h6 class="card-title">Compras</h6>
                                        <h3>
                                            <t t-esc="formatCurrency(state.chartData.purchases)"/> $
                                        </h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-white"
                                     t-att-style="isProfit() ? 'background-color: #8fbf9f;' : 'background-color: #e0988f;'">
                                    <div class="card-body text-center">
                                        <h6 class="card-title">
                                            <t t-if="isProfit()">Ganancia</t>
                                            <t t-else="">Pérdida</t>
                                        </h6>
                                        <h3>
                                            <t t-esc="formatAbsCurrency(state.chartData.profit)"/> $
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
