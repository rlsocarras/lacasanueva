<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- ============================================ -->
        <!-- Vista de formulario de variante (acceso directo) -->
        <!-- ============================================ -->
        <record id="product_product_form_view_la_casa_nueva" model="ir.ui.view">
        <field name="name">product.product.form.la.casa.nueva</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Stock Manual La Casa Nueva (Variante)" 
                       name="manual_stock_variant_group"
                       colspan="4"
                       invisible="not can_manage_manual_stock">
                    <div colspan="4" class="alert alert-info">
                        <i class="fa fa-info-circle"/> 
                        Stock informativo para el sitio web. 
                        <strong>NO afecta al stock real.</strong>
                    </div>
                    
                    <group colspan="2">
                        <field name="manual_stock" 
                               string="Stock Manual"
                               placeholder="Ingrese el stock manual"/>
                    </group>
                    
                    <group colspan="2">
                        <field name="is_manual_stock_modified" readonly="1"/>
                        <field name="last_manual_stock_update" readonly="1"/>
                        <field name="last_manual_stock_user" readonly="1"/>
                        <field name="last_import_date" readonly="1"/>
                    </group>
                    
                    <group colspan="4">
                        <button name="action_sync_stock_to_website" 
                                type="object" 
                                string="Sincronizar con Sitio Web"
                                class="btn-secondary"
                                icon="fa-globe"/>
                        <button name="action_open_website" 
                                type="object" 
                                icon="fa-globe"
                                class="btn-sm"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Vista de variante desde el TEMPLATE (popup) -->
    <!-- XML ID CORRECTO: product.product_variant_easy_edit_view -->
    <!-- ============================================ -->
    <record id="product_product_variant_easy_edit_view_la_casa_nueva" model="ir.ui.view">
        <field name="name">product.product.variant.easy.edit.view.la.casa.nueva</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            
            <!-- Insertar Stock Manual después del barcode (dentro del grupo Codes) -->
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="manual_stock" 
                       string="Stock Manual"
                       placeholder="Ingrese el stock manual"
                       help="Stock manual de esta variante. NO afecta al stock real."
                       invisible="not can_manage_manual_stock"/>
            </xpath>
            
            <!-- Insertar grupo de trazabilidad al final del sheet -->
            <xpath expr="//sheet" position="inside">
                <group name="manual_stock_info" string="Stock Manual La Casa Nueva"
                invisible="not can_manage_manual_stock">
                    <div colspan="2" class="alert alert-info">
                        <i class="fa fa-info-circle"/> 
                        Stock informativo para el sitio web. NO afecta al stock real.
                    </div>
                    <group>
                        <field name="is_manual_stock_modified" 
                               string="Modificado"
                               readonly="1"/>
                    </group>
                    <group>
                        <field name="last_manual_stock_update" 
                               string="Última Actualización"
                               readonly="1"/>
                        <field name="last_manual_stock_user" 
                               string="Actualizado Por"
                               readonly="1"/>
                    </group>
                </group>
            </xpath>
            
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Stock Manual visible para TODOS en lista y kanban de variantes -->
    <!-- ============================================ -->
    <record id="view_product_product_tree_manual_stock" model="ir.ui.view">
        <field name="name">product.product.tree.manual_stock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="manual_stock" widget="number_increment" string="Stock Manual" 
                       readonly="not can_manage_manual_stock"/>
                <field name="last_import_date" string="Última importación" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_kanban_manual_stock" model="ir.ui.view">
        <field name="name">product.product.kanban.manual_stock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="qty_available" invisible="1"/>
                <field name="manual_stock" invisible="1"/>
            </xpath>
            <xpath expr="//t[@t-name='card']/main" position="inside">
                <div class="d-flex mb-1 small">
                    <span class="fw-medium me-1">Stock real:</span>
                    <field name="qty_available" readonly="1"/>
                </div>
                <div name="manual_stock_line" class="d-flex mb-1 small">
                    <span class="fw-medium me-1">Stock Manual:</span>
                    <field name="manual_stock" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>