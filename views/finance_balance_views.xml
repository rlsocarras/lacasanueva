<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de cliente para el tablero -->
    <record id="action_finance_balance" model="ir.actions.client">
        <field name="name">Balance de Compras y Ventas</field>
        <field name="tag">lacasanueva.finance_balance</field>
        <field name="target">current</field>
    </record>

    <!-- 
        Menú raíz: La Casa Nueva
        - Aparece en el menú principal de aplicaciones
        - Usa el icono del módulo
    -->
    <menuitem id="menu_lacasanueva_root"
              name="La Casa Nueva"
              web_icon="lacasanueva,static/description/icon.png"
              sequence="95"/>

    <!-- Submenú: Reportes -->
    <menuitem id="menu_finance_balance"
              name="Reportes"
              parent="menu_lacasanueva_root"
              action="action_finance_balance"
              sequence="10"/>
</odoo>