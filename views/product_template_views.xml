<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_la_casa_nueva" model="ir.ui.view">
        <field name="name">product.template.form.inherit.la.casa.nueva</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Stock Manual La Casa Nueva" 
                       name="manual_stock_group"
                       colspan="4"
                       invisible="is_variant_view or not is_asociado">
                    
                    <!-- SIN VARIANTES -->
                    <div colspan="4" 
                         class="alert alert-warning"
                         invisible="has_variants">
                        <i class="fa fa-exclamation-triangle"/> 
                        <strong>Stock informativo</strong> para el sitio web. NO afecta al stock real.
                    </div>
                    
                    <group colspan="2" invisible="has_variants">
                        <field name="manual_stock" 
                               string="Stock Manual"
                               placeholder="Ingrese el stock manual"
                               help="Stock manual. NO afecta al stock real."/>
                    </group>
                    
                    <!-- CON VARIANTES -->
                    <div colspan="4" 
                         class="alert alert-info"
                         invisible="not has_variants">
                        <i class="fa fa-info-circle"/> 
                        Este producto tiene variantes. El stock manual se edita en cada variante.
                    </div>
                    
                    <group colspan="2" invisible="not has_variants">
                        <field name="manual_stock_summary" 
                               string="Stock Manual Total"
                               readonly="1"/>
                    </group>
                    
                    <!-- TRAZABILIDAD -->
                    <group colspan="2">
                        <field name="is_manual_stock_modified_summary" 
                               string="Modificado"
                               readonly="1"/>
                        <field name="last_manual_stock_update_summary" 
                               string="Última Actualización"
                               readonly="1"/>
                        <field name="last_manual_stock_user_summary" 
                               string="Actualizado Por"
                               readonly="1"/>
                    </group>
                    
                    <!-- BOTÓN -->
                    <group colspan="4">
                        <button name="action_sync_stock_to_website" 
                                type="object" 
                                string="Sincronizar con Sitio Web"
                                class="btn-secondary"
                                icon="fa-globe"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_template_list_view_inherit_la_casa_nueva" model="ir.ui.view">
        <field name="name">product.template.list.inherit.la.casa.nueva</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="manual_stock_summary" 
                       string="Stock Manual Total"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>