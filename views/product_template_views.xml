<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario de plantilla de producto -->
    <record id="product_template_form_view_inherit_la_casa_nueva" model="ir.ui.view">
        <field name="name">product.template.form.inherit.la.casa.nueva</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Agregar sección de stock manual en la pestaña de inventario -->
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Stock Manual La Casa Nueva" 
                       name="manual_stock_group">
                    <group colspan="2">
                        <field name="manual_stock" 
                               string="Stock Manual"
                               placeholder="Ingrese el stock manual"
                               help="Stock modificado manualmente por usuarios asociados"/>
                    </group>
                    <group colspan="2">
                        <field name="is_manual_stock_modified" 
                               string="Modificado Manualmente"
                               readonly="1"/>
                    </group>
                    <group colspan="2">
                        <field name="last_manual_stock_update" 
                               string="Última Actualización"
                               readonly="1"/>
                    </group>
                    <group colspan="2">
                        <field name="last_manual_stock_user" 
                               string="Actualizado Por"
                               readonly="1"/>
                    </group>
                    <group colspan="4">
                        <!-- Aquí sí usamos action_update_manual_stock que existe en product.template -->
                        <button name="action_update_manual_stock" 
                                type="object" 
                                string="Actualizar Stock Manual"
                                class="btn-primary"
                                icon="fa-refresh"/>
                        <button name="action_sync_stock_to_website" 
                                type="object" 
                                string="Sincronizar con Sitio Web"
                                class="btn-secondary"
                                icon="fa-globe"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Vista de lista de plantilla de producto -->
    <record id="product_template_list_view_inherit_la_casa_nueva" model="ir.ui.view">
        <field name="name">product.template.list.inherit.la.casa.nueva</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="manual_stock" 
                       string="Stock Manual"
                       optional="show"/>
                <field name="is_manual_stock_modified" 
                       string="Modificado"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>